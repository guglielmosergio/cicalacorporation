---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Guglielmo Sergio"
  description="The page you are looking for does not exist."
>
  <section class="min-h-[100dvh] flex flex-col items-center justify-center text-center px-6 pt-24 pb-10 bg-black text-white">
    <p class="font-['Helvetica'] font-bold text-[#cc0000] text-6xl md:text-8xl tracking-tight">
      404
    </p>

    <h1 class="font-['Helvetica'] font-bold uppercase text-xl md:text-3xl tracking-[0.15em] mt-4">
      Page not found
    </h1>

        <p class="font-['Helvetica'] text-neutral-400 text-sm md:text-base mt-4 px-4">
      The page you are looking for does not exist<br class="md:hidden" /> or has been moved.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 mt-10">
      <a
        href="/"
        class="min-h-[44px] px-6 inline-flex items-center justify-center rounded-full bg-white text-black font-['Helvetica'] font-bold uppercase text-xs tracking-wider hover:bg-neutral-300 transition-colors"
      >
        Back to home
      </a>
      <a
        href="/horizontal-16-9"
        class="min-h-[44px] px-6 inline-flex items-center justify-center rounded-full border border-white/30 text-white font-['Helvetica'] font-bold uppercase text-xs tracking-wider hover:bg-white hover:text-black transition-colors"
      >
        Watch recent works
      </a>
    </div>
  </section>
</Layout>