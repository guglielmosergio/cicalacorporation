---
import Layout from '../layouts/Layout.astro';

const vimeoIds = [
  '995329353',
  '860185895',
  '852064585',
  '1027982516',
  '1151188018',
  '874010772',
  '761154118',
  '860197064',
  '958279465',
  '753730057',
  '668962747',
  '668959166',
  '789637436',
  '954834750',
  '954829075',
  '1042709074',
  '1168468674?h=98298cb7bb',
  '1164359028?h=51bd55a542',
  '1197379915?h=0f7f2f7be3',
  '1228143178?h=2421dc7d95',
  '1228145885?h=d098332646'
];

const videosWithData = await Promise.all(
  vimeoIds.map(async (id) => {
    try {
      const cleanUrl = id.replace('?h=', '/');
      const response = await fetch(`https://vimeo.com/api/oembed.json?url=https://vimeo.com/${cleanUrl}&width=960`);
      const data = await response.json();

      return {
        originalId: id,
        thumb: data.thumbnail_url,
        title: data.title
      };
    } catch (error) {
      return { originalId: id, thumb: '', title: 'Video' };
    }
  })
);
---

<Layout>
  <!-- NIENTE "relative z-10" qui: creerebbe un livello che tiene il modale sotto header e footer -->
  <video-gallery class="block pt-32 pb-32 px-5 md:px-10 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-10">
      {videosWithData.map((video) => (
        <div
          class="video-thumb relative aspect-video bg-neutral-900 rounded-sm overflow-hidden cursor-pointer group shadow-lg"
          data-vimeo-id={video.originalId}
        >
          {video.thumb ? (
            <img
              src={video.thumb}
              alt={video.title}
              class="w-full h-full object-cover brightness-75 group-hover:brightness-110 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full bg-neutral-800 brightness-75 group-hover:brightness-110 group-hover:scale-105 transition-all duration-500"></div>
          )}
        </div>
      ))}
    </div>

    <!-- MODALE -->
    <div id="video-modal" class="fixed inset-0 z-[9999] bg-black hidden w-screen h-[100dvh] overflow-hidden select-none">

      <!-- Sfondo cliccabile per chiudere -->
      <div id="modal-bg-close" class="absolute inset-0 z-[1000] cursor-pointer"></div>

      <!-- Video -->
      <div class="absolute inset-0 z-[2000] pointer-events-none flex items-center justify-center">
        <iframe
          id="modal-iframe"
          src=""
          class="w-full max-w-[177.78vh] aspect-video max-h-[100dvh] block pointer-events-auto bg-black"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <!-- CLOSE: sempre in alto a destra, area di tocco >= 44px, rispetta la notch -->
      <button
        id="close-modal"
        type="button"
        aria-label="Chiudi video"
        class="absolute z-[3000] top-[max(1rem,env(safe-area-inset-top))] right-[max(1rem,env(safe-area-inset-right))] md:top-8 md:right-10
               min-h-[44px] px-5 inline-flex items-center justify-center rounded-full
               bg-black/60 backdrop-blur-sm border border-white/20
               text-white font-['Helvetica'] font-bold text-xs uppercase tracking-wider leading-none
               cursor-pointer whitespace-nowrap transition-colors duration-200
               hover:bg-white hover:text-black active:scale-95"
      >
        Close
      </button>

    </div>
  </video-gallery>
</Layout>

<script>
  class VideoGallery extends HTMLElement {
    onKeydown = null;

    connectedCallback() {
      const thumbs = this.querySelectorAll('.video-thumb');
      const modal = this.querySelector('#video-modal');
      const iframe = this.querySelector('#modal-iframe');
      const closeBtn = this.querySelector('#close-modal');
      const bgClose = this.querySelector('#modal-bg-close');

      if (!modal || !iframe || !closeBtn || !bgClose) return;

      const openModal = (id) => {
        const separator = id.includes('?') ? '&' : '?';
        const vimeoUrl =
          'https://player.vimeo.com/video/' + id + separator +
          'autoplay=1&playsinline=1&color=ffffff&title=0&byline=0&portrait=0';

        iframe.setAttribute('src', vimeoUrl);
        modal.classList.remove('hidden');
        modal.classList.add('block');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = (e) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        modal.classList.add('hidden');
        modal.classList.remove('block');
        iframe.setAttribute('src', '');
        document.body.style.overflow = '';
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const id = thumb.getAttribute('data-vimeo-id');
          if (id) openModal(id);
        });
      });

      closeBtn.addEventListener('click', closeModal);
      bgClose.addEventListener('click', closeModal);

      this.onKeydown = (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(e);
      };
      document.addEventListener('keydown', this.onKeydown);
    }

    disconnectedCallback() {
      if (this.onKeydown) document.removeEventListener('keydown', this.onKeydown);
      document.body.style.overflow = '';
    }
  }

  if (!customElements.get('video-gallery')) {
    customElements.define('video-gallery', VideoGallery);
  }
</script>