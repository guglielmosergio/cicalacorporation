---
// src/layouts/Layout.astro
import '../styles/global.css'
import discover from '../assets/Discover.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/horizontal-16-9', label: 'Horizontal 16:9' },
  { href: '/vertical-9-16', label: 'Vertical 9:16' },
  { href: '/photos', label: 'Photos' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const taglines = [
  {
    code: 'en', label: 'English',
    lines: ['Elevate your identity through premium visual storytelling,', 'contact me today to bring your project to life.'],
    flag: '<svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg"><clipPath id="fl-s"><path d="M0,0 v30 h60 v-30 z"/></clipPath><clipPath id="fl-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><g clip-path="url(#fl-s)"><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#fl-t)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></g></svg>',
  },
  {
    code: 'it', label: 'Italiano',
    lines: ['Valorizza la tua identità attraverso un racconto visivo d\'eccellenza,', 'scrivimi oggi stesso e diamo vita al tuo progetto.'],
    flag: '<svg viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="1" height="2" fill="#009246"/><rect x="1" width="1" height="2" fill="#fff"/><rect x="2" width="1" height="2" fill="#CE2B37"/></svg>',
  },
  {
    code: 'fr', label: 'Français',
    lines: ['Sublimez votre identité à travers un récit visuel d\'exception,', 'contactez-moi dès aujourd\'hui pour donner vie à votre projet.'],
    flag: '<svg viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="1" height="2" fill="#0055A4"/><rect x="1" width="1" height="2" fill="#fff"/><rect x="2" width="1" height="2" fill="#EF4135"/></svg>',
  },
  {
    code: 'es', label: 'Español',
    lines: ['Eleva tu identidad a través de una narrativa visual de excelencia,', 'contacta conmigo hoy mismo para dar vida a tu proyecto.'],
    flag: '<svg viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="3" height="2" fill="#AA151B"/><rect y="0.5" width="3" height="1" fill="#F1BF00"/></svg>',
  },
  {
    code: 'ja', label: '日本語',
    lines: ['卓越した映像表現で、あなたのアイデンティティを高める。', 'プロジェクトをカタチにするため、今すぐお問い合わせください。'],
    flag: '<svg viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="3" height="2" fill="#fff"/><circle cx="1.5" cy="1" r="0.6" fill="#BC002D"/></svg>',
  },
];
const gears = [
  // English
  'I am a videomaker with proprietary equipment: Sony FX3, FX30 and Sony GM lenses, Atomos Shogun Ultra, Nanlite lights, PolarPro filters and matte box, Cartoni tripod, DJI gimbal with Tilta ecosystem, Tilta shoulder rig, Zoom F6, Rode NTG3, NTK and Wireless Pro, color grading with Mac Studio, Eizo CG3100X, UltraStudio 4K Mini, DaVinci Resolve Studio, Logic Pro, Neumann NDH30, Auratone 5C, Focusrite ISA One, RME Babyface PRO-FS, Shure SM7DB, iZotope RX 12 Advanced, Final Draft. Available for productions worldwide.',
  // Italiano
  'Sono un videomaker con attrezzatura proprietaria Sony FX3, FX30 e lenti Sony GM, Atomos Shogun Ultra, Luci Nanlite, Polarpro Filtri e Mattebox, Cartoni Treppiede, DJI Gimbal con Ecosistema Tilta, Spallaccio Tilta, Zoom F6, Rode NTG3, NTK e Wireless Pro, Color Grading con Mac Studio, Eizo CG3100X, Ultrastudio 4K mini, Davinci Resolve Studio, Logic Pro, Neumann NDH30, Auratone 5C, Focusrite ISA One, RME Babyface PRO-FS, Shure SM7DB, iZotope RX 12 Advanced, Final Draft. Disponibile per produzioni in tutto il mondo.',
  // Français
  'Je suis vidéaste avec mon propre équipement Sony FX3, FX30 et objectifs Sony GM, Atomos Shogun Ultra, lumières Nanlite, filtres PolarPro et matte box, trépied Cartoni, stabilisateur DJI avec écosystème Tilta, harnais d\'épaule Tilta, Zoom F6, Rode NTG3, NTK et Wireless Pro, étalonnage avec Mac Studio, Eizo CG3100X, UltraStudio 4K Mini, DaVinci Resolve Studio, Logic Pro, Neumann NDH30, Auratone 5C, Focusrite ISA One, RME Babyface PRO-FS, Shure SM7DB, iZotope RX 12 Advanced, Final Draft. Disponible pour des productions dans le monde entier.',
  // Español
  'Soy videógrafo con equipo propio Sony FX3, FX30 y objetivos Sony GM, Atomos Shogun Ultra, luces Nanlite, filtros PolarPro y matte box, trípode Cartoni, gimbal DJI con ecosistema Tilta, arnés de hombro Tilta, Zoom F6, Rode NTG3, NTK y Wireless Pro, etalonaje con Mac Studio, Eizo CG3100X, UltraStudio 4K Mini, DaVinci Resolve Studio, Logic Pro, Neumann NDH30, Auratone 5C, Focusrite ISA One, RME Babyface PRO-FS, Shure SM7DB, iZotope RX 12 Advanced, Final Draft. Disponible para producciones en todo el mundo.',
  // 日本語
  'ビデオグラファーとして、Sony FX3・FX30とSony GMレンズ、Atomos Shogun Ultra、Nanliteライト、PolarProフィルターとマットボックス、Cartoniトライポッド、DJIジンバルとTiltaエコシステム、Tiltaショルダーリグ、Zoom F6、Rode NTG3・NTK・Wireless Pro、Mac Studio、Eizo CG3100X、UltraStudio 4K Miniでのカラーグレーディング、DaVinci Resolve Studio、Logic Pro、Neumann NDH30、Auratone 5C、Focusrite ISA One、RME Babyface PRO-FS、Shure SM7DB、iZotope RX 12 Advanced、Final Draftなど、機材を自社で所有しています。世界中の制作に対応可能です。',
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="view-transitions" content="same-origin">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Guglielmo Sergio</title>
  </head>
  <body class="bg-black">

    <!-- HEADER: pointer-events-none così la barra invisibile non blocca i click sotto di essa -->
    <header class="fixed top-0 w-full z-50 p-6 flex justify-between items-center pointer-events-none">
      <a href="https://cicalacorporation.com" target="_blank" class="shrink-0 pointer-events-auto">
        <img
          src={discover.src}
          alt="Discover"
          class="h-14 w-auto max-w-[65vw] object-contain md:h-20 md:max-w-none"
        />
      </a>

      <!-- Menu desktop -->
      <nav class="hidden md:block pointer-events-auto">
        <ul class="flex space-x-4">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-white font-['Helvetica'] font-bold uppercase text-sm hover:opacity-70 transition-opacity"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Pulsante hamburger (solo mobile) -->
      <button
        id="menu-btn"
        type="button"
        class="md:hidden relative w-11 h-11 flex items-center justify-center pointer-events-auto"
        aria-label="Apri il menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger-line" data-line="1"></span>
        <span class="burger-line" data-line="2"></span>
      </button>
    </header>

    <!-- Menu mobile a tendina -->
    <div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true">
      <nav class="w-full px-8">
        <ul class="flex flex-col">
          {links.map((l, i) => {
            const active = path === l.href;
            return (
              <li class="menu-item" style={`--i:${i}`}>
                <a
                  href={l.href}
                  class:list={['menu-link', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="menu-dot"></span>
                  <span class="menu-label">{l.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <a
        href="mailto:cicalacorporation@gmail.com"
        class="menu-item menu-mail"
        style="--i:5"
      >
        cicalacorporation@gmail.com
      </a>
    </div>

    <main>
      <slot />
    </main>

    <!-- INIZIO FOOTER / FILIGRANA CONTATTI -->
        <footer
      class:list={[
        'site-footer w-full bg-black pb-12 flex flex-col items-center justify-center relative z-0 mt-auto font-[\'Helvetica\']',
        path === '/' ? 'pt-6 md:pt-8' : 'pt-6 MD:PT-8',
      ]}
    >

      <!-- Tagline multilingua (solo home) -->
            <!-- Tagline multilingua (solo home) -->
      {path === '/' && (
        <div class="lang-tagline mb-10 flex flex-col items-center px-4 text-center w-full max-w-4xl" data-lang-tagline>
          <div class="grid w-full">
            {taglines.map((t, i) => (
              <div
                lang={t.code}
                class:list={['tagline-text', { 'is-active': i === 0 }]}
                aria-hidden={i === 0 ? 'false' : 'true'}
                style="grid-area: 1 / 1;"
              >
                <p class="gear-text">
                  {gears[i].split(/(?<=[,、.。])\s*/).filter(Boolean).map((seg) => (
                    <Fragment><span class="seg">{seg}</span>{' '}</Fragment>
                  ))}
                </p>
                <p class="tl-main">
                  <span class="tl-line">{t.lines[0]}</span>{' '}
                  <span class="tl-line">{t.lines[1]}</span>
                </p>
              </div>
            ))}
          </div>

          <div class="flex items-center gap-3 mt-5">
            {taglines.map((t, i) => (
              <button
                type="button"
                class:list={['flag-btn', { 'is-active': i === 0 }]}
                data-index={i}
                aria-label={t.label}
                title={t.label}
              >
                <Fragment set:html={t.flag} />
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Email -->
      <a
        href="mailto:cicalacorporation@gmail.com"
        class="text-white font-bold text-2xl md:text-3xl tracking-tight hover:text-neutral-300 transition-colors mb-2"
      >
        cicalacorporation@gmail.com
      </a>

      <!-- Numero di Telefono -->
      <a
        href="tel:+393474579349"
        class="text-[#cc0000] font-bold text-2xl md:text-3xl tracking-tight hover:brightness-125 transition-all mb-6"
      >
        +393474579349
      </a>

      <!-- Icone Social -->
      <div class="flex items-center gap-5 md:gap-6 mb-10">

        <!-- WhatsApp -->
        <a
          href="https://wa.me/393474579349"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center hover:scale-110 transition-transform duration-200 cursor-pointer"
          aria-label="WhatsApp"
        >
          <svg viewBox="0 0 24 24" fill="#25D366" class="w-8 h-8">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.94 9.94 0 0 0 1.333 4.993L2 22l5.233-1.237a9.95 9.95 0 0 0 4.779 1.221h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.664-1.037-5.168-2.924-7.056A9.91 9.91 0 0 0 12.012 2zm0 18.232h-.003a8.27 8.27 0 0 1-4.218-1.162l-.302-.18-3.13.74.808-3.044-.197-.314A8.25 8.25 0 0 1 3.763 11.984c0-4.549 3.702-8.25 8.252-8.25 2.204 0 4.276.859 5.834 2.419a8.203 8.203 0 0 1 2.414 5.835c-.001 4.55-3.702 8.244-8.251 8.244zm4.52-6.18c-.248-.124-1.468-.724-1.696-.807-.228-.083-.393-.124-.559.124-.165.248-.64.807-.785.973-.145.165-.289.186-.537.062-.248-.124-1.047-.386-1.995-1.231-.738-.658-1.237-1.47-1.382-1.718-.145-.248-.015-.382.109-.505.111-.111.248-.289.372-.434.124-.145.165-.248.248-.413.083-.165.041-.31-.021-.434-.062-.124-.559-1.348-.765-1.844-.201-.484-.405-.418-.559-.426l-.476-.008c-.165 0-.434.062-.661.31-.227.248-.868.848-.868 2.068 0 1.22.889 2.399 1.013 2.564.124.165 1.748 2.67 4.236 3.744.592.256 1.054.409 1.414.523.594.189 1.134.162 1.561.098.476-.071 1.468-.6 1.674-1.18.206-.579.206-1.075.145-1.18-.062-.104-.227-.165-.475-.289z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@cicalacorporation"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center hover:scale-110 transition-transform duration-200 cursor-pointer"
          aria-label="YouTube"
        >
          <svg viewBox="0 0 24 24" class="w-8 h-8">
            <path
              fill="#FF0000"
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"
            />
            <path
              fill="#FFFFFF"
              d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z"
