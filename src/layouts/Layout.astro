      </div>

      <!-- Scritta finale -->
      <p class="text-neutral-500 text-[11px] md:text-xs tracking-[0.2em] uppercase text-center px-4">
        DO YOU LIKE THIS WEBSITE?<br class="md:hidden" /> CONTACT ME TO CREATE YOUR OWN.
      </p>

    </footer>
    <!-- FINE FOOTER / FILIGRANA CONTATTI -->

    <style is:global>
      /* ---------- Hamburger ---------- */
      .burger-line {
        position: absolute;
        left: 50%;
        width: 26px;
        height: 2px;
        background: #fff;
        border-radius: 2px;
        transform: translateX(-50%);
        transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1), width 0.3s ease;
      }
      .burger-line[data-line="1"] { top: 15px; }
      .burger-line[data-line="2"] { top: 27px; width: 18px; }

      #menu-btn[aria-expanded="true"] .burger-line[data-line="1"] {
        transform: translateX(-50%) translateY(6px) rotate(45deg);
      }
      #menu-btn[aria-expanded="true"] .burger-line[data-line="2"] {
        width: 26px;
        transform: translateX(-50%) translateY(-6px) rotate(-45deg);
      }

      /* ---------- Pannello a tendina ---------- */
      .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: rgba(0, 0, 0, 0.96);
        -webkit-backdrop-filter: blur(18px);
        backdrop-filter: blur(18px);
        font-family: 'Helvetica', Arial, sans-serif;
        clip-path: inset(0 0 100% 0);
        visibility: hidden;
        transition: clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s linear 0.7s;
      }
      .mobile-menu.is-open {
        clip-path: inset(0 0 0 0);
        visibility: visible;
        transition: clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s;
      }

      /* ---------- Voci con effetto cascata ---------- */
      .menu-item {
        opacity: 0;
        transform: translateY(-24px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .mobile-menu.is-open .menu-item {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(0.25s + var(--i) * 0.08s);
      }

      .menu-link {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        padding: 0.95rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        transition: color 0.25s ease, padding-left 0.25s ease;
      }
      .menu-link:active { padding-left: 0.5rem; opacity: 0.7; }

      .menu-label { font-size: clamp(1.15rem, 5.2vw, 1.55rem); line-height: 1; }

      .menu-dot {
        flex-shrink: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        transition: background 0.25s ease, transform 0.25s ease;
      }
      .menu-link.is-active .menu-label { color: #cc0000; }
      .menu-link.is-active .menu-dot { background: #cc0000; transform: scale(1.3); }

      .menu-mail {
        position: absolute;
        bottom: 2.5rem;
        left: 0;
        right: 0;
        text-align: center;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      body.menu-open { overflow: hidden; }

      /* ---------- Tagline multilingua ---------- */
      .tagline-text {
        opacity: 0;
        transform: translateY(6px);
        pointer-events: none;
        transition: opacity 0.7s ease, transform 0.7s ease;
        text-transform: uppercase;
        text-align: center;
        hyphens: none;
      }
      .tagline-text.is-active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      /* Attrezzatura: più piccola e più tenue */
      .gear-text {
        margin: 0 0 1rem;
        color: rgba(255, 255, 255, 0.55);
        font-size: clamp(0.5rem, 2.3vw, 0.8rem);
        line-height: 1.8;
        letter-spacing: 0.04em;
      }
      .seg { display: inline-block; max-width: 100%; }

      /* Frase principale: più grande e più chiara */
      .tl-main {
        margin: 0;
        color: rgba(255, 255, 255, 0.9);
        font-size: clamp(0.4rem, 2vw, 1.1rem);
        line-height: 1.7;
        letter-spacing: 0;
      }
      .tl-line { display: block; }

      @media (min-width: 768px) {
        .gear-text { font-size: 0.8rem; }
        .tl-main { font-size: 1.1rem; letter-spacing: 0.02em; }
        .tl-line { display: block; }
      }

      .flag-btn {
        width: 22px;
        height: 15px;
        border-radius: 3px;
        overflow: hidden;
        opacity: 0.4;
        cursor: pointer;
        transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
      }
      .flag-btn svg { width: 100%; height: 100%; display: block; }
      .flag-btn:hover { opacity: 0.8; }
      .flag-btn.is-active {
        opacity: 1;
        transform: scale(1.15);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
      }
    </style>

    <script is:inline>
      function initMobileMenu() {
        const btn = document.getElementById('menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu || btn.dataset.init) return;
        btn.dataset.init = 'true';

        const setOpen = (open) => {
          menu.classList.toggle('is-open', open);
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
          menu.setAttribute('aria-hidden', String(!open));
          document.body.classList.toggle('menu-open', open);
        };

        btn.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
        window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
      }

      initMobileMenu();
      document.addEventListener('astro:page-load', initMobileMenu);

      function initTagline() {
        const root = document.querySelector('[data-lang-tagline]');
        if (!root || root.dataset.init) return;
        root.dataset.init = 'true';

        const texts = Array.from(root.querySelectorAll('.tagline-text'));
        const flags = Array.from(root.querySelectorAll('.flag-btn'));
        let current = 0;
        let timer = null;

        const show = (i) => {
          current = i;
          texts.forEach((t, k) => {
            t.classList.toggle('is-active', k === i);
            t.setAttribute('aria-hidden', String(k !== i));
          });
          flags.forEach((f, k) => f.classList.toggle('is-active', k === i));
        };

        const start = (delay = 6000) => {
          clearInterval(timer);
          timer = setInterval(() => show((current + 1) % texts.length), delay);
        };

        flags.forEach((f, i) => {
          f.addEventListener('click', () => {
            show(i);
            clearInterval(timer);
            // dopo 20 secondi riprende la rotazione automatica
            timer = setTimeout(() => start(), 20000);
          });
        });

        start();
      }

      initTagline();
      document.addEventListener('astro:page-load', initTagline);
    </script>

  </body>
</html>